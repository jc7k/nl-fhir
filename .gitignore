# Open Source Project Configuration
# Community-friendly .gitignore for medical AI software

# Development-only files moved to internal-dev branch
# .bmad-core/ - Proprietary AI tooling (now in internal-dev branch)
# test_comprehensive_*.py - Temporary test files (removed)
# AGENTS.md - Internal documentation (removed)

# Environment variables - SECURITY CRITICAL
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Test coverage
.coverage
.pytest_cache/
htmlcov/

# Test results and artifacts (Phase 4 cleanup)
# Test result outputs
tests/results/
# Timestamped test data files
tests/data/*_202*.json

# Mac
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Medical AI / Healthcare specific
# Patient Health Information files
*.phi
# Patient data files
*.patient
# Patient-related test data
*_patient_*
# Real patient data (should never exist)
real_patient_*
# Clinical data that might contain PHI
clinical_data.json
# Any medical record files
medical_records.*
# Never let the PHI patterns above swallow test modules (e.g. test_patient_factory.py)
!test_*.py

# Open Source Community
# Proprietary AI chat configurations (removed)
.github/chatmodes/
# Internal development files
internal_*
# Any proprietary code or configurations
proprietary_*

# Development AI Tooling (local-only, not tracked in git)
# These tools are for personal development workflow and should not be in production
# BMAD AI development framework
.bmad-core/
# Claude AI development configurations
.claude/
# Gemini AI development configurations
.gemini/
# Serena code analysis tool
.serena/
# GitHub Spec Kit planning tools
.specify/

# Development tool caches and outputs
.bmad-core/cache/
.serena/cache/
.specify/output/

# Development artifacts
# Temporary test files
temp_test_*.py
# Debug scripts not for community
debug_*.py
# Personal development files
personal_*.py

# Temporary files that should be organized in proper directories
# Test result files (should go in tests/results/)
/*_results_*.json
# Temporary API test files
/first_request.json
# Application logs (should go in logs/ or tests/results/)
/startup.log
# Marketing materials (should go in docs/marketing/)
/linkedin_*
# Playwright MCP browser artifacts
.playwright-mcp/
# Test output files
/*_test_*.json
# Quality analysis files
/data_quality_*.json
# NLP test results
/medspacy_*.json
